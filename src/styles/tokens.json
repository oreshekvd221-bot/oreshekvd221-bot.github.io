{
  "$comment": "Wanderloop design tokens. Same values as tokens.css. 'a11y' entries are proposed accessible text variants.",
  "color": {
    "bg": "#FFFDF7", "surface": "#F5F0E1", "text": "#2C3524", "textMuted": "#A5A5A5",
    "accent": "#C97C5D", "accentSoft": "#F5F0E1", "accent2": "#7D8C5C", "line": "#A5A5A5",
    "footerBg": "#F5F0E1", "footerText": "#7D8C5C",
    "scarce": {"text": "#C97C5D", "bg": "#F5F0E1"},
    "ok": {"text": "#7D8C5C", "bg": "#E5F2CA"},
    "unavailable": {"text": "#C97C5D", "bg": "#F5F0E1"},
    "a11y": {
      "textSubtle": "#6D6D6D", "accentText": "#995E47", "accentStrong": "#A5664C",
      "accent2Text": "#64704A", "lineStrong": "#878787", "onAccent": "#FFFFFF",
      "focus": "#2C3524", "error": "#9B2C20", "errorBg": "#FBE9E4"
    }
  },
  "font": {
    "family": "Jost",
    "weights": {"light": 300, "regular": 400, "semibold": 600, "bold": 700, "black": 900},
    "desktop": {
      "display": {"size": 32, "lineHeight": 38, "letterSpacing": "-2%", "weight": 900},
      "h2": {"size": 24, "lineHeight": 30, "letterSpacing": "-1%", "weight": 700},
      "h3": {"size": 20, "lineHeight": 26, "letterSpacing": "-0.5%", "weight": 600},
      "body": {"size": 16, "lineHeight": 24, "letterSpacing": "0%", "weight": 400},
      "caption": {"size": 12, "lineHeight": 16, "letterSpacing": "1%", "weight": 300}
    },
    "mobile": {
      "display": {"size": 26, "lineHeight": 32, "letterSpacing": "-1.5%", "weight": 700},
      "h2": {"size": 20, "lineHeight": 26, "letterSpacing": "-0.5%", "weight": 600},
      "body": {"size": 16, "lineHeight": 24, "letterSpacing": "0%", "weight": 400},
      "caption": {"size": 12, "lineHeight": 16, "letterSpacing": "1%", "weight": 300}
    }
  },
  "space": {"scale": [0, 4, 8, 12, 24, 32, 64],
    "desktop": {"pagePaddingX": 40, "contentMaxWidth": 1360},
    "mobile": {"pagePaddingX": 20, "contentMaxWidth": 362}},
  "radius": {"field": 8, "button": 999, "card": 24, "pill": 999},
  "shadow": {
    "card": {"x": 0, "y": 4, "blur": 4, "color": "#BEBEBE", "opacity": 0.25},
    "popover": {"x": 0, "y": 4, "blur": 4, "color": "#BEBEBE", "opacity": 0.25}
  },
  "frames": {"mobile": 402, "desktop": 1440}
}
