---
// Layout: reference/figma/desktop/02-tour-page.png and mobile/02-tour-page.png.
// The "What's included" checklist only appears in the mobile export, but the
// data has included/notIncluded for every tour, so it's shown on both sizes
// (ask Veronika to confirm the desktop frame should have had it too).
import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import TourCard from '../../components/TourCard.astro';
import BookingCard from '../../components/BookingCard.astro';
import chevronIcon from '../../assets/icons/chevron-down-24.svg';
import checkIcon from '../../assets/icons/check-circle-30.svg';
import closeIcon from '../../assets/icons/close-circle-30.svg';
import arrowLeftIcon from '../../assets/icons/arrow-left-20.svg';
import arrowRightIcon from '../../assets/icons/arrow-right-20.svg';
import toursData from '../../data/tours.json';

export function getStaticPaths() {
  return toursData.tours.map((tour) => ({
    params: { slug: tour.slug },
    props: { tour },
  }));
}

const { tour } = Astro.props;

const images = import.meta.glob('../../assets/images/*/*.{jpg,jpeg,png}', { eager: true });

function tourImages(folder: string) {
  return Object.keys(images)
    .filter((key) => key.includes(`/images/${folder}/`))
    .sort()
    .map((key) => images[key].default);
}

function coverImage(folder: string) {
  return tourImages(folder)[0] ?? null;
}

const gallery = tourImages(tour.imageFolder);
// Full-size versions of the same photos, for the fullscreen viewer — the
// <Image> components on the page render much smaller crops.
const galleryFull = await Promise.all(gallery.map((img) => getImage({ src: img, width: 1600 })));
const similarTours = (tour.similar ?? [])
  .map((slug: string) => toursData.tours.find((t) => t.slug === slug))
  .filter(Boolean)
  .slice(0, 3);
---

<Layout title={tour.name} headerMobileSearch={false}>
  <article class="container tour-page">
    <section class="gallery" aria-label="Photos">
      {
        gallery[0] && (
          <button
            type="button"
            class="gallery__main-wrap"
            data-gallery-trigger
            data-full-src={galleryFull[0].src}
            aria-label={`Open photo 1 of ${gallery.length} full screen`}
          >
            <Image class="gallery__main" src={gallery[0]} alt={`${tour.name} — ${tour.place}`} width={960} height={640} />
          </button>
        )
      }
      <div class="gallery__thumbs">
        {
          gallery.slice(1).map((img, i) => {
            const index = i + 1;
            return (
              <button
                type="button"
                class="gallery__thumb-wrap"
                data-gallery-trigger
                data-full-src={galleryFull[index].src}
                aria-label={`Open photo ${index + 1} of ${gallery.length} full screen`}
              >
                <Image src={img} alt="" width={420} height={420} loading="lazy" />
              </button>
            );
          })
        }
      </div>
    </section>

    <div
      class="lightbox"
      data-lightbox
      hidden
      role="dialog"
      aria-modal="true"
      aria-label={`${tour.name} photos`}
    >
      <button type="button" class="lightbox__close" data-lightbox-close aria-label="Close">
        <svg width="26" height="26" viewBox="0 0 30 30" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path
            d="M15 16.75L8.875 22.875C8.64583 23.1042 8.35417 23.2188 8 23.2188C7.64583 23.2188 7.35417 23.1042 7.125 22.875C6.89583 22.6458 6.78125 22.3542 6.78125 22C6.78125 21.6458 6.89583 21.3542 7.125 21.125L13.25 15L7.125 8.875C6.89583 8.64583 6.78125 8.35417 6.78125 8C6.78125 7.64583 6.89583 7.35417 7.125 7.125C7.35417 6.89583 7.64583 6.78125 8 6.78125C8.35417 6.78125 8.64583 6.89583 8.875 7.125L15 13.25L21.125 7.125C21.3542 6.89583 21.6458 6.78125 22 6.78125C22.3542 6.78125 22.6458 6.89583 22.875 7.125C23.1042 7.35417 23.2188 7.64583 23.2188 8C23.2188 8.35417 23.1042 8.64583 22.875 8.875L16.75 15L22.875 21.125C23.1042 21.3542 23.2188 21.6458 23.2188 22C23.2188 22.3542 23.1042 22.6458 22.875 22.875C22.6458 23.1042 22.3542 23.2188 22 23.2188C21.6458 23.2188 21.3542 23.1042 21.125 22.875L15 16.75Z"
            fill="currentColor"
          />
        </svg>
      </button>
      <button type="button" class="lightbox__nav lightbox__nav--prev" data-lightbox-prev aria-label="Previous photo">
        <img src={arrowLeftIcon.src} alt="" width="20" height="20" />
      </button>
      <button type="button" class="lightbox__nav lightbox__nav--next" data-lightbox-next aria-label="Next photo">
        <img src={arrowRightIcon.src} alt="" width="20" height="20" />
      </button>
      <img class="lightbox__image" data-lightbox-image alt="" />
      <p class="lightbox__count" data-lightbox-count aria-hidden="true"></p>
    </div>

    <div class="tour-page__layout">
      <div class="tour-page__main">
        <p class="tour-page__place">{tour.place}</p>
        <h1>{tour.name}</h1>
        <p class="tour-page__meta">{tour.meta}</p>

        <section aria-labelledby="about-heading">
          <h2 id="about-heading">About this trip</h2>
          {tour.about.map((paragraph: string) => <p>{paragraph}</p>)}
        </section>

        <section aria-labelledby="itinerary-heading">
          <h2 id="itinerary-heading">Day-by-day itinerary</h2>
          <div class="itinerary">
            {
              tour.itinerary.map((item: any, i: number) => (
                <div class="itinerary__item">
                  <div class="itinerary__row">
                    <span class="itinerary__number">{item.day}</span>
                    <div class="itinerary__col">
                      <button
                        type="button"
                        class="itinerary__trigger"
                        data-itinerary-trigger
                        aria-expanded="false"
                        aria-controls={`itinerary-body-${i}`}
                      >
                        <span class="itinerary__title">{item.title}</span>
                        <img class="itinerary__chevron" src={chevronIcon.src} alt="" width="24" height="24" />
                      </button>
                      <div id={`itinerary-body-${i}`} class="itinerary__body" hidden>
                        <p>{item.description}</p>
                      </div>
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </section>

        <section aria-labelledby="included-heading">
          <h2 id="included-heading">What's included</h2>
          <div class="included-columns">
            <ul class="included-list">
              {
                tour.included.map((label: string) => (
                  <li>
                    <img src={checkIcon.src} alt="" width="30" height="30" />
                    <span class="visually-hidden">Included:</span> {label}
                  </li>
                ))
              }
            </ul>
            <ul class="included-list">
              {
                tour.notIncluded.map((label: string) => (
                  <li class="included-list__excluded">
                    <img src={closeIcon.src} alt="" width="30" height="30" />
                    <span class="visually-hidden">Not included:</span> {label}
                  </li>
                ))
              }
            </ul>
          </div>
        </section>

        {
          similarTours.length > 0 && (
            <section class="similar-trips" aria-labelledby="similar-heading">
              <h2 id="similar-heading">Similar trips</h2>
              <div class="similar-trips__grid">
                {similarTours.map((similar: any) => (
                  <TourCard tour={similar} cover={coverImage(similar.imageFolder)} hideActions />
                ))}
              </div>
            </section>
          )
        }
      </div>

      <BookingCard tour={tour} />
    </div>
  </article>
</Layout>

<script src="../../scripts/itinerary.js"></script>
<script src="../../scripts/gallery-lightbox.js"></script>

<style>
  .tour-page {
    /* No extra top padding on mobile — the header already has its own 20px
       bottom padding, and adding this on top of that was pushing the
       gallery photo down much further than Figma. Restored for desktop
       below, where the layout needs the breathing room. */
    padding-block: 0 var(--space-6);
  }

  .gallery {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-bottom: 48px;
  }

  .gallery__main-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 10px;
    overflow: hidden;
  }

  .gallery__main-wrap :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery__thumbs {
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
  }

  .gallery__thumb-wrap {
    position: relative;
    width: 120px;
    height: 120px;
    border-radius: 10px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .gallery__thumb-wrap :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Every gallery photo is a button that opens the fullscreen viewer: reset
     the native button chrome, then lift the photo slightly on hover/focus
     (moves up, grows a touch, a shadow grows in behind it) so it reads as
     clickable and feels alive rather than just lit up. */
  .gallery__main-wrap,
  .gallery__thumb-wrap {
    display: block;
    border: none;
    padding: 0;
    background: none;
    cursor: pointer;
    transition: transform 0.35s ease-out, box-shadow 0.35s ease-out;
  }

  .gallery__main-wrap:hover,
  .gallery__main-wrap:focus-visible,
  .gallery__thumb-wrap:hover,
  .gallery__thumb-wrap:focus-visible {
    transform: translateY(-6px) scale(1.02);
    box-shadow: 0 16px 32px rgba(44, 53, 36, 0.2);
  }

  /* Fullscreen photo viewer. Same blurred backdrop as the auth modal, so the
     page shows through softly instead of a flat color block; the photo gets
     a strong shadow of its own so it still reads as a card floating above it.
     `display: none` is written out explicitly instead of relying on the
     `[hidden]` attribute alone — on some mobile WebKit versions, a
     `position: fixed` + `backdrop-filter` element can stay in the touch
     hit-test layer even while hidden that way, silently blocking taps
     (e.g. the header logo) on everything underneath it. */
  .lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 300;
    background: rgba(44, 53, 36, 0.4);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    align-items: center;
    justify-content: center;
    padding: var(--space-6) var(--space-5);
  }

  .lightbox:not([hidden]) {
    display: flex;
  }

  .lightbox__image {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: var(--radius-field);
    box-shadow: 0 24px 48px rgba(44, 53, 36, 0.35);
  }

  .lightbox__close,
  .lightbox__nav {
    border: none;
    padding: 0;
  }

  /* The default focus ring is dark green — invisible against this overlay's
     near-identical color, so lightbox controls get a light one instead. */
  .lightbox button:focus-visible {
    outline-color: var(--color-bg);
  }

  .lightbox__close {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    background: none;
    color: var(--color-bg);
    line-height: 0;
  }

  .lightbox__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 253, 247, 0.92);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox__nav--prev {
    left: var(--space-4);
  }

  .lightbox__nav--next {
    right: var(--space-4);
  }

  .lightbox__count {
    position: absolute;
    bottom: var(--space-4);
    left: 50%;
    transform: translateX(-50%);
    color: var(--color-bg);
    font-size: var(--text-caption-size);
  }

  @media (min-width: 768px) {
    .lightbox__nav {
      width: 56px;
      height: 56px;
    }
  }

  .tour-page__place {
    color: var(--color-text-subtle);
    font-size: var(--text-caption-size);
    font-weight: var(--weight-semibold);
  }

  .tour-page__main h1 {
    margin-top: var(--space-3);
  }

  .tour-page__meta {
    color: var(--color-text-subtle);
    margin-top: var(--space-3);
  }

  .tour-page__main section {
    margin-top: var(--space-5);
  }

  .tour-page__main h2 {
    font-size: var(--text-h2-size);
    font-weight: var(--text-h2-weight);
    margin-bottom: var(--space-3);
  }

  .tour-page__main p + p {
    margin-top: var(--space-3);
  }

  .itinerary__item {
    border-bottom: 1px solid var(--color-line);
  }

  /* The number badge sits outside the toggle button and centers against
     the title+description block as a whole, not just the title line. */
  .itinerary__row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-3);
  }

  .itinerary__col {
    flex: 1;
    min-width: 0;
  }

  .itinerary__trigger {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    background: none;
    border: none;
    text-align: left;
  }

  /* A 44px touch target without the button itself taking up 44px of
     layout height — that extra height was the visible gap under the
     title, since it centered the text inside a taller box. */
  .itinerary__trigger::after {
    content: '';
    position: absolute;
    inset: -12px 0;
  }

  .itinerary__number {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-accent-soft);
    color: var(--color-accent-text);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: var(--weight-semibold);
  }

  .itinerary__title {
    flex: 1;
    font-weight: var(--weight-semibold);
  }

  .itinerary__chevron {
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }

  .itinerary__trigger[aria-expanded='false'] .itinerary__chevron {
    transform: rotate(180deg);
  }

  /* No gap between the title and the description below it. */
  .itinerary__body {
    color: var(--color-text-subtle);
  }

  .itinerary__body p {
    margin: 0;
  }

  .included-columns {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .included-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .included-list li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .included-list__excluded {
    color: var(--color-text-subtle);
  }

  @media (min-width: 768px) {
    .included-columns {
      flex-direction: row;
      gap: var(--space-5);
    }

    .included-list {
      flex: 1;
    }
  }

  .tour-page__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    align-items: start;
  }

  .similar-trips h2 {
    font-size: var(--text-h2-size);
    font-weight: var(--text-h2-weight);
    margin-bottom: var(--space-4);
  }

  .similar-trips__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .tour-page {
      padding-top: var(--space-5);
    }

    .gallery {
      /* 816:518 — the exact ratio of the 816px photo to the 247*2+24 gap
         thumbnail grid next to it, so it stays fluid at other widths. */
      grid-template-columns: 1.575fr 1fr;
      height: 500px;
    }

    .gallery__main-wrap {
      width: 100%;
      height: 100%;
      aspect-ratio: auto;
      border-radius: var(--radius-card);
    }

    .gallery__thumbs {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 1fr 1fr;
      gap: var(--space-4);
      height: 100%;
      overflow: visible;
    }

    .gallery__thumb-wrap {
      width: 100%;
      height: 100%;
      border-radius: var(--radius-card);
    }

    .tour-page__layout {
      grid-template-columns: 1fr 411px;
      gap: 64px;
    }

    .tour-page__layout :global(.booking-card) {
      position: sticky;
      top: var(--space-4);
    }

    /* A horizontal scroll row, not a wrapping grid: this column is
       narrower than the catalog grid (it shares the row with the sticky
       booking card), and the cards must stay the catalog's exact size and
       stay together on one line rather than wrapping — so when they don't
       all fit, the row scrolls instead. */
    .similar-trips__grid {
      display: flex;
      overflow-x: auto;
      padding-bottom: var(--space-1);
    }

    .similar-trips__grid :global(.tour-card) {
      flex: 0 0 437px;
    }
  }
</style>
