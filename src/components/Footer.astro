---
// Footer links are static per CLAUDE.md: only "All trips" is a real page.
// The rest render as inactive text so the footer matches Figma without creating pages that don't exist.
// Layout/labels: reference/figma/components/footer.png and footer-mobile.png.
import desktopLogo from '../assets/logo/desktop-logo.svg';

const year = new Date().getFullYear();

const columns = [
  {
    heading: 'Company',
    links: [
      { label: 'About us' },
      { label: 'How it works' },
      { label: 'Blog' },
      { label: 'Contact' },
    ],
  },
  {
    heading: 'Trips',
    links: [
      { label: 'All trips', href: '/tours' },
      { label: 'Popular destinations' },
      { label: 'Upcoming departure dates' },
    ],
  },
  {
    heading: 'Support',
    links: [
      { label: 'Help center' },
      { label: 'Booking terms' },
      { label: 'Cancellations & refunds' },
      { label: 'FAQ' },
    ],
  },
];

const legalLinks = ['Privacy Policy', 'Terms of Service'];
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <img src={desktopLogo.src} alt="Wanderloop" width="140" height="28" />
        <p class="site-footer__tagline">Small groups. Real routes.</p>
      </div>

      <div class="site-footer__columns">
        {
          columns.map((column) => (
            <div class="site-footer__column">
              <h2 class="site-footer__heading">{column.heading}</h2>
              <ul>
                {column.links.map((link) => (
                  <li>
                    {link.href ? <a href={link.href}>{link.label}</a> : <span>{link.label}</span>}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="site-footer__legal">
      <p>&copy; {year} Wanderloop. All rights reserved.</p>
      <ul>
        {legalLinks.map((label) => (
          <li><span>{label}</span></li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-footer-bg);
    margin-top: var(--space-6);
  }

  .site-footer__inner {
    padding-block: var(--space-5) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .site-footer__top {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .site-footer__tagline {
    margin-top: var(--space-2);
    color: var(--color-text);
  }

  .site-footer__columns {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-4);
  }

  .site-footer__heading {
    font-size: var(--text-h3-size);
    font-weight: var(--weight-bold);
    margin-bottom: var(--space-3);
    color: var(--color-accent-2-text);
  }

  .site-footer__column ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .site-footer__column a {
    color: var(--color-accent-2-text);
    text-decoration: none;
  }

  .site-footer__column span {
    color: var(--color-accent-2-text);
  }

  .site-footer__legal {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    border-top: 1px solid var(--color-line);
    padding-top: var(--space-4);
    color: var(--color-text-subtle);
    font-size: var(--text-caption-size);
  }

  .site-footer__legal p {
    margin: 0;
  }

  .site-footer__legal ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-4);
  }

  .site-footer__legal span {
    color: var(--color-text-subtle);
    text-decoration: underline;
  }

  @media (min-width: 768px) {
    .site-footer__inner {
      padding-block: var(--space-5) var(--space-4);
      gap: var(--space-4);
    }

    .site-footer__top {
      flex-direction: row;
      align-items: center;
      gap: 196px;
    }

    .site-footer__columns {
      flex-wrap: nowrap;
      gap: 196px;
    }

    .site-footer__column {
      min-width: 180px;
    }

    .site-footer__legal {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
